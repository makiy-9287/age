# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
REASONING_EFFORT=low

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=8893521930:AAHh4kFLjh_PWLWzkCcu8OepukqKOJVWipw
TELEGRAM_CHAT_ID=5530953384


# ---- Scanner ----
MIN_24H_QUOTE_VOLUME=50000000
SCAN_SECONDS=900          # one scan per closed 15m candle
ALIGN_TO_CANDLE=1
ALIGN_OFFSET=15
COINS_PER_REQUEST=35
ACTIVE_START=06:00
ACTIVE_END=21:00
LOCAL_TZ=Asia/Colombo

# ---- Token conservation ----
# Skip coins with no live POI near price, no recent sweep, no recent structure
# shift. This is the biggest saving available. Set to 0 to send every coin.
PREFILTER=1
# Gate mode. Measured pass rates (test data, 63-coin universe):
#   any        ~100%  63 coins  57k tok/scan   CMP within 1% of ANY level
#   near        ~81%  51 coins  46k tok/scan   within 1% of a live OB/FVG/BB
#   inside      ~30%  19 coins  17k tok/scan   CMP inside a live POI
#   confluence  ~10%   6 coins   6k tok/scan   inside + HTF bias + bos + prem/disc
GATE_MODE=inside
GATE_POI_TFS=15m,1h
GATE_NEAR_PCT=1.0         # used by 'any' and 'near' modes only
# Which level types count. Measured pass rate at 1%:
#   ob,fvg,bb,sr,liq -> ~100%  (S/R and liquidity lines are dense; near no-op)
#   ob,fvg,bb        -> ~88%
#   ob,fvg           -> ~80%
GATE_LEVELS=ob,fvg,bb,sr,liq
NEAR_15M=1.0
NEAR_1H=2
NEAR_4H=2.5
MAX_TOOL_ROUNDS=3

# Your DeepSeek rates, USD per 1M tokens (used only for /cost)
PRICE_IN_HIT=0.014
PRICE_IN_MISS=0.28
PRICE_OUT=1.32

# ---- Monitor ----
MONITOR_SECONDS=60
